#!/bin/sh
# Every commit starts with [t-<task id>] or [chore] (HQ rule). Merge, revert, fixup and squash commits pass.
first=$(head -n 1 "$1")
case "$first" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"amend! "*|"[chore]"*) exit 0 ;;
esac
if printf '%s\n' "$first" | grep -Eq '^\[t-[A-Za-z0-9][A-Za-z0-9-]*\]'; then exit 0; fi
echo "Commit refused: the first line must start with [t-<task id>] (e.g. [t-p26-519iyv]) or [chore]." >&2
exit 1
